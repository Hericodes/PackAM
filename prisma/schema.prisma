generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
  RUNNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum VendorType {
  SHOP
  RESTAURANT
  PRINTING
  PHARMACY
  SUPERMARKET
  OTHER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  FINDING_RUNNER
  RUNNER_ASSIGNED
  SOURCING_PRODUCT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_PROCESSING
  REFUNDED
  FAILED
}

enum OrderKind {
  MARKETPLACE
  PRINTING
}

enum PrintJobStatus {
  DRAFT
  READY_FOR_PAYMENT
  PAYMENT_CONFIRMED
  FINDING_RUNNER
  RUNNER_ASSIGNED
  DOCUMENT_RECEIVED
  PRINTING
  PRINTED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  DOCUMENT_UNREADABLE
  PRINT_FAILED
  REFUND_PROCESSING
  REFUNDED
  FAILED
}

enum PrintPaperSize {
  A4
}

enum PrintColorMode {
  BLACK_AND_WHITE
  COLOR
}

enum PrintSides {
  SINGLE
  DOUBLE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  RECONCILIATION_REQUIRED
  FAILED
  REFUNDED
}

enum OrderItemSourcingStatus {
  UNAVAILABLE
  SOURCED
  PRICE_PENDING
  APPROVED
  REJECTED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  OPAY
  OTHER
}

enum RunnerAssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  COMPLETED
  CANCELLED
}

enum ProductAvailability {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

enum ProductRequestStatus {
  PENDING
  CHECKING
  AVAILABLE
  UNAVAILABLE
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
  PRODUCT_REQUEST
  ACCOUNT
  SYSTEM
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum IncidentType {
  PRODUCT_UNAVAILABLE
  PRICE_CHANGE
  RUNNER_ABANDONED
  CUSTOMER_UNAVAILABLE
  WRONG_ITEM
  MISSING_ITEM
  DAMAGED_ITEM
  PAYMENT_ISSUE
  DELIVERY_ISSUE
  OTHER
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}


// ============================================================
// USERS
// ============================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?    @unique
  passwordHash  String?
  role          UserRole
  status        UserStatus @default(ACTIVE)

  firstName     String?
  lastName      String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  studentProfile       StudentProfile?
  runnerProfile        RunnerProfile?
  adminProfile         AdminProfile?

  savedLocations       SavedLocation[]
  carts                Cart[]
  orders               Order[]
  printJobs            PrintJob[]
  uploadedPrintDocuments PrintDocument[] @relation("UploadedPrintDocuments")
  printJobStatusHistory PrintJobStatusHistory[]
  payments             Payment[]
  productRequests      ProductRequest[]
  notifications        Notification[]
  supportCases         SupportCase[]
  incidents             Incident[]       @relation("ReportedIncidents")
  auditLogs             AuditLog[]
  handledSupportCases   SupportCase[]     @relation("HandledSupportCases")

  @@index([role])
  @@index([status])
}


// ============================================================
// USER PROFILES
// ============================================================

model StudentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique

  matricNumber String?
  department   String?
  faculty      String?
  level       String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RunnerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique

  isAvailable Boolean  @default(false)
  isVerified  Boolean  @default(false)

  totalDeliveries Int @default(0)
  completedDeliveries Int @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments RunnerAssignment[]
  assignedOrders Order[] @relation("AssignedRunner")
  sourcingReports OrderItemSourcing[]
  payouts     RunnerPayout[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id          String        @id @default(cuid())
  categoryId  String

  name        String
  slug        String        @unique
  description String?
  imageUrl    String?

  // Current customer-facing price.
  // Historical order prices are stored separately.
  customerPrice Int

  status      ProductStatus @default(ACTIVE)

  category    Category      @relation(fields: [categoryId], references: [id])

  sources     ProductSource[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  requests    ProductRequest[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
}


// ============================================================
// VENDORS / SOURCES
// ============================================================

model Vendor {
  id          String       @id @default(cuid())

  name        String
  type        VendorType   @default(OTHER)
  location    String?
  phone       String?

  status      VendorStatus @default(ACTIVE)

  reliabilityScore Float?

  notes       String?

  sources     ProductSource[]
  orderSources OrderSource[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}


// ============================================================
// PRODUCT â†” VENDOR
// ============================================================

model ProductSource {
  id          String   @id @default(cuid())

  productId   String
  vendorId    String

  currentPrice Int?
  availability ProductAvailability @default(UNKNOWN)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  priceRecords       PriceRecord[]
  availabilityRecords AvailabilityRecord[]
  itemSourcing OrderItemSourcing[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, vendorId])
  @@index([productId])
  @@index([vendorId])
}

model PriceRecord {
  id              String   @id @default(cuid())

  productSourceId String
  price           Int

  recordedAt      DateTime @default(now())

  productSource   ProductSource @relation(fields: [productSourceId], references: [id], onDelete: Cascade)

  @@index([productSourceId])
  @@index([recordedAt])
}

model AvailabilityRecord {
  id              String              @id @default(cuid())

  productSourceId String
  availability    ProductAvailability

  recordedAt      DateTime @default(now())

  productSource   ProductSource @relation(fields: [productSourceId], references: [id], onDelete: Cascade)

  @@index([productSourceId])
  @@index([recordedAt])
}


// ============================================================
// SAVED LOCATIONS
// ============================================================

model SavedLocation {
  id          String   @id @default(cuid())
  userId      String

  label       String
  address     String
  instructions String?

  latitude    Float?
  longitude   Float?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}


// ============================================================
// CART
// ============================================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())

  cartId    String
  productId String

  quantity  Int

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}


// ============================================================
// ORDERS
// ============================================================

model Order {
  id          String      @id @default(cuid())
  userId      String
  kind        OrderKind   @default(MARKETPLACE)

  status      OrderStatus

  subtotal    Int
  deliveryFee Int
  total       Int

  // Snapshot of what the customer was charged.
  // This protects historical order records from future price changes.
  currency    String      @default("NGN")

  deliveryLocationId String?
  deliveryAddress    String
  deliveryInstructions String?
  assignedRunnerId String?
  findingRunnerAt DateTime?

  user          User            @relation(fields: [userId], references: [id])
  deliveryLocation SavedLocation? @relation(fields: [deliveryLocationId], references: [id])

  items         OrderItem[]
  printJob      PrintJob?
  payment       Payment?
  assignments   RunnerAssignment[]
  assignedRunner RunnerProfile? @relation("AssignedRunner", fields: [assignedRunnerId], references: [id])
  sources       OrderSource[]
  refunds       Refund[]
  statusHistory OrderStatusHistory[]
  incidents     Incident[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deliveredAt   DateTime?

  @@index([userId])
  @@index([kind, status])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())

  orderId     String
  productId   String

  // Historical snapshots.
  productName String
  unitPrice   Int
  quantity    Int
  totalPrice  Int

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourcing    OrderItemSourcing[]
  product     Product  @relation(fields: [productId], references: [id])

  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}


// ============================================================
// ORDER SOURCES
// ============================================================

model OrderSource {
  id        String @id @default(cuid())

  orderId   String
  vendorId  String

  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor    Vendor @relation(fields: [vendorId], references: [id])
  itemSourcing OrderItemSourcing[]

  createdAt DateTime @default(now())

  @@unique([orderId, vendorId])
}

model OrderItemSourcing {
  id                 String                 @id @default(cuid())
  orderItemId        String
  orderSourceId      String
  productSourceId    String
  reportedByRunnerId String
  status             OrderItemSourcingStatus
  quantity           Int                    @default(0)
  catalogueUnitPrice Int
  actualUnitPrice    Int?
  autoApproved       Boolean                @default(false)
  priceDecisionAt    DateTime?
  priceDecisionBy    String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderSource   OrderSource   @relation(fields: [orderSourceId], references: [id], onDelete: Cascade)
  productSource ProductSource @relation(fields: [productSourceId], references: [id])
  reportedBy    RunnerProfile @relation(fields: [reportedByRunnerId], references: [id])

  @@index([orderItemId, status])
  @@index([orderSourceId])
  @@index([reportedByRunnerId])
}


// ============================================================
// RUNNER ASSIGNMENTS
// ============================================================

model RunnerAssignment {
  id        String   @id @default(cuid())

  orderId   String
  runnerId  String

  status    RunnerAssignmentStatus @default(OFFERED)

  offeredAt DateTime @default(now())
  acceptedAt DateTime?
  completedAt DateTime?

  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  runner    RunnerProfile @relation(fields: [runnerId], references: [id])

  @@index([orderId])
  @@index([runnerId])
  @@index([status])
  @@unique([orderId, runnerId])
}


// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id                  String          @id @default(cuid())
  userId              String
  orderId             String?         @unique
  printJobId          String?

  provider            PaymentProvider
  status              PaymentStatus   @default(PENDING)
  amount              Int
  currency            String          @default("NGN")

  // PackAM's unique attempt reference and the provider's unique transaction reference.
  transactionReference String?        @unique
  idempotencyKey       String?
  providerReference    String?         @unique
  providerCheckoutReference String?    @unique
  cashierUrl           String?

  // Immutable item/address/price snapshot captured when the attempt is created.
  // Nullable to retain compatibility with payments created before this lifecycle.
  checkoutSnapshot     Json?

  paidAt               DateTime?
  failedAt             DateTime?

  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  order                Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printJob             PrintJob?       @relation(fields: [printJobId], references: [id], onDelete: Restrict)

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status])
  @@index([printJobId, status])
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
}

model PrintJob {
  id                 String         @id @default(cuid())
  userId             String
  orderId            String?        @unique
  status             PrintJobStatus @default(DRAFT)

  paperSize          PrintPaperSize @default(A4)
  colorMode          PrintColorMode?
  sides              PrintSides?
  copies             Int            @default(1)
  pageSelection      String         @default("ALL")
  selectedPageCount  Int?
  instructions       String?

  pricePerPage       Int?
  printSubtotal      Int?
  deliveryFee        Int?
  total              Int?
  pricingVersion     String?
  checkoutSnapshot   Json?
  replacesPrintJobId String?

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order              Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  document           PrintDocument?
  payments           Payment[]
  statusHistory      PrintJobStatusHistory[]

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model PrintDocument {
  id               String    @id @default(cuid())
  printJobId       String    @unique
  uploadedById     String
  publicId         String    @unique
  originalFileName String
  mimeType         String
  fileSize         Int
  pageCount        Int
  storageProvider  String    @default("CLOUDINARY")
  uploadedAt       DateTime  @default(now())
  expiresAt        DateTime?
  deletedAt        DateTime?

  printJob         PrintJob  @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  uploadedBy       User      @relation("UploadedPrintDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([uploadedById, uploadedAt])
  @@index([expiresAt, deletedAt])
}

model PrintJobStatusHistory {
  id          String         @id @default(cuid())
  printJobId  String
  status      PrintJobStatus
  note        String?
  actorId     String?
  createdAt   DateTime       @default(now())

  printJob    PrintJob       @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([printJobId, createdAt])
  @@index([actorId, createdAt])
}


// ============================================================
// REFUNDS
// ============================================================

model Refund {
  id          String       @id @default(cuid())

  orderId     String

  amount      Int
  reason      String

  status      RefundStatus @default(PENDING)

  transactionReference String?
  requestKey  String? @unique

  processedAt DateTime?

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}


// ============================================================
// ORDER STATUS HISTORY
// ============================================================

model OrderStatusHistory {
  id        String      @id @default(cuid())

  orderId   String
  status    OrderStatus

  note      String?
  createdBy String?

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}


// ============================================================
// PRODUCT REQUESTS
// ============================================================

model ProductRequest {
  id          String              @id @default(cuid())

  userId      String
  productId   String?

  requestedName String
  quantity      Int               @default(1)
  variant       String?
  description   String?

  status      ProductRequestStatus @default(PENDING)

  user        User                @relation(fields: [userId], references: [id])
  product     Product?            @relation(fields: [productId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}


// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(cuid())

  userId    String

  type      NotificationType
  title     String
  message   String

  isRead    Boolean          @default(false)

  orderId   String?
  idempotencyKey String?
  relatedType String?
  relatedId   String?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@unique([userId, idempotencyKey])
}


// ============================================================
// SUPPORT
// ============================================================

model SupportCase {
  id          String            @id @default(cuid())

  userId      String

  subject     String
  description String

  status      SupportCaseStatus @default(OPEN)

  orderId     String?
  resolution  String?
  handledById String?

  user        User              @relation(fields: [userId], references: [id])
  handledBy   User?             @relation("HandledSupportCases", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderId])
  @@index([handledById])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  resource     String
  resourceId   String
  previousState Json?
  newState      Json?
  details      String?
  createdAt    DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@index([action, createdAt])
}

model RateLimitBucket {
  id         String   @id @default(cuid())
  key        String
  windowStart DateTime
  count      Int      @default(0)
  expiresAt  DateTime

  @@unique([key, windowStart])
  @@index([expiresAt])
}


// ============================================================
// INCIDENTS
// ============================================================

model Incident {
  id          String         @id @default(cuid())

  orderId     String
  reportedById String

  type        IncidentType
  status      IncidentStatus @default(OPEN)

  description String?
  resolution  String?

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reportedBy  User           @relation("ReportedIncidents", fields: [reportedById], references: [id])

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([orderId])
  @@index([reportedById])
  @@index([status])
}


// ============================================================
// RUNNER PAYOUTS
// ============================================================

model RunnerPayout {
  id          String       @id @default(cuid())

  runnerId    String

  amount      Int
  status      PayoutStatus @default(PENDING)

  periodStart DateTime?
  periodEnd   DateTime?

  reference   String?

  runner      RunnerProfile @relation(fields: [runnerId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([runnerId])
  @@index([status])
}
