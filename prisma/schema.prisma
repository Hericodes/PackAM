generator client {
  provider        = "prisma-client-js"
  // Needed for Payment_one_success_per_print_job (partial unique index).
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}


// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  STUDENT
  RUNNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AccountTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum VendorType {
  SHOP
  RESTAURANT
  PRINTING
  PHARMACY
  SUPERMARKET
  OTHER
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  FINDING_RUNNER
  RUNNER_ASSIGNED
  SOURCING_PRODUCT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_PROCESSING
  REFUNDED
  FAILED
}

enum OrderKind {
  MARKETPLACE
  PRINTING
}

enum PrintJobStatus {
  DRAFT
  READY_FOR_PAYMENT
  PAYMENT_CONFIRMED
  FINDING_RUNNER
  RUNNER_ASSIGNED
  DOCUMENT_RECEIVED
  PRINTING
  PRINTED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  DOCUMENT_UNREADABLE
  PRINT_FAILED
  REFUND_PROCESSING
  REFUNDED
  FAILED
}

enum PrintPaperSize {
  A4
}

enum PrintColorMode {
  BLACK_AND_WHITE
  COLOR
}

enum PrintSides {
  SINGLE
  DOUBLE
}

/// Whether operations is still working on a payment review. Never describes the money itself.
enum PaymentReviewStatus {
  OPEN
  CLOSED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  RECONCILIATION_REQUIRED
  FAILED
  REFUNDED
}

enum OrderItemSourcingStatus {
  UNAVAILABLE
  SOURCED
  PRICE_PENDING
  APPROVED
  REJECTED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  OPAY
  OTHER
}

enum RunnerAssignmentStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  COMPLETED
  CANCELLED
}

/// How a food shop's menu item is used. Null on every non-food product.
enum FoodRole {
  /// A ready-made meal sold as one item at a fixed price.
  MEAL
  /// A base or portion a plate is built on (one per plate).
  BASE
  /// An optional soup for a built plate (at most one per plate).
  SOUP
  /// An individually priced extra for a built plate (quantity 1..maxPerPlate, at most 5).
  EXTRA
}

enum ProductAvailability {
  AVAILABLE
  UNAVAILABLE
  UNKNOWN
}

enum ProductRequestStatus {
  PENDING
  CHECKING
  AVAILABLE
  UNAVAILABLE
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  ORDER
  PAYMENT
  DELIVERY
  PRODUCT_REQUEST
  ACCOUNT
  SYSTEM
}

enum SupportCaseStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum IncidentType {
  PRODUCT_UNAVAILABLE
  PRICE_CHANGE
  RUNNER_ABANDONED
  CUSTOMER_UNAVAILABLE
  WRONG_ITEM
  MISSING_ITEM
  DAMAGED_ITEM
  PAYMENT_ISSUE
  DELIVERY_ISSUE
  OTHER
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}


// ============================================================
// USERS
// ============================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?    @unique
  passwordHash  String?
  role          UserRole
  status        UserStatus @default(ACTIVE)

  firstName     String?
  lastName      String?

  /// When the person confirmed they own `email`; null = not confirmed. Accounts made before migration
  /// 20261101090000 start unconfirmed, and nothing is blocked by it yet.
  emailVerifiedAt   DateTime?
  /// Bumped to sign the account out on every device: each session cookie carries the version it was
  /// issued with, and src/auth.ts refuses any other. Cookies from before this column count as 0.
  sessionVersion    Int        @default(0)
  passwordChangedAt DateTime?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  studentProfile       StudentProfile?
  runnerProfile        RunnerProfile?
  adminProfile         AdminProfile?

  savedLocations       SavedLocation[]
  carts                Cart[]
  orders               Order[]
  printJobs            PrintJob[]
  uploadedPrintDocuments PrintDocument[] @relation("UploadedPrintDocuments")
  printJobStatusHistory PrintJobStatusHistory[]
  payments             Payment[]
  productRequests      ProductRequest[]
  notifications        Notification[]
  supportCases         SupportCase[]
  incidents             Incident[]       @relation("ReportedIncidents")
  auditLogs             AuditLog[]
  handledSupportCases   SupportCase[]     @relation("HandledSupportCases")
  accountTokens         AccountToken[]

  @@index([role])
  @@index([status])
  @@index([role, createdAt])
}


// ============================================================
// USER PROFILES
// ============================================================

model StudentProfile {
  id          String   @id @default(cuid())
  userId      String   @unique

  matricNumber String?
  department   String?
  faculty      String?
  level       String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RunnerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique

  isAvailable Boolean  @default(false)
  isVerified  Boolean  @default(false)

  totalDeliveries Int @default(0)
  completedDeliveries Int @default(0)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments RunnerAssignment[]
  assignedOrders Order[] @relation("AssignedRunner")
  assignedPrintJobs PrintJob[] @relation("AssignedPrintRunner")
  sourcingReports OrderItemSourcing[]
  payouts     RunnerPayout[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ============================================================
// ACCOUNT TOKENS
// ============================================================

/// A one-time emailed link: email verification, password reset or an email change. Only the SHA-256 of
/// the raw token is stored (src/lib/account/tokens.ts); the raw value exists only in the link. A token is
/// used once (usedAt), and issuing a new one marks the user's older unused ones of that purpose used.
/// Database CHECK constraints (not expressible in Prisma), see migration 20261101090000:
///   AccountToken_tokenHash_check: tokenHash is 64 characters.
///   AccountToken_expiry_check: expiresAt is after createdAt.
model AccountToken {
  id        String              @id @default(cuid())
  userId    String
  purpose   AccountTokenPurpose
  tokenHash String              @unique
  /// The address the link was sent to (for EMAIL_CHANGE: the new address).
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}


// ============================================================
// CATEGORIES
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  /// Lower numbers are listed first; ties are listed by name.
  sortOrder   Int      @default(0)

  products      Product[]
  subcategories Subcategory[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


// ============================================================
// PRODUCTS
// ============================================================

model Product {
  id          String        @id @default(cuid())
  categoryId  String

  name        String
  slug        String        @unique
  description String?
  imageUrl    String?

  // Current customer-facing price.
  // Historical order prices are stored separately.
  // 0 means "price not set yet": such a product must stay INACTIVE. Enforced by the database CHECK
  // constraint Product_active_requires_price_check (migration 20261020170000), not expressible in Prisma.
  customerPrice Int

  status      ProductStatus @default(ACTIVE)

  // Food menu items only (all null for marketplace products). A food item belongs to exactly one shop
  // and has a role; database CHECKs keep shopId and foodRole set together (migration 20261028090000).
  shopId      String?
  foodRole    FoodRole?
  /// Admin-chosen menu heading, e.g. "Rice and meals". Free text; nothing is built in.
  menuSection String?
  /// EXTRA only: the most a student may add to one plate (1..5). Null means the default of 5.
  maxPerPlate Int?

  /// Optional narrower group inside the category. A database trigger keeps it inside the product's
  /// own category (migration 20261030090000).
  subcategoryId String?
  /// Simple (variant-less) products only. Null = stock not tracked: runners source on demand, as before.
  stockQuantity Int?

  category    Category      @relation(fields: [categoryId], references: [id])
  subcategory Subcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  shop        Vendor?       @relation("FoodShopMenu", fields: [shopId], references: [id], onDelete: Restrict)

  sources     ProductSource[]
  cartItems   CartItem[]
  cartExtras  CartItemExtra[]
  orderItems  OrderItem[]
  labels      ProductLabelOnProduct[]
  options     ProductOption[]
  variants    ProductVariant[]
  requests    ProductRequest[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([shopId, status])
  @@index([status])
}


// ============================================================
// VENDORS / SOURCES
// ============================================================

model Vendor {
  id          String       @id @default(cuid())

  name        String
  type        VendorType   @default(OTHER)
  location    String?
  phone       String?

  status      VendorStatus @default(ACTIVE)

  reliabilityScore Float?

  notes       String?

  // Food shops. Only these (with name and location) are ever shown to students, and only while
  // listedInFood is true. Existing vendors start unlisted and closed.
  description  String?
  imageUrl     String?
  isOpen       Boolean @default(false)
  listedInFood Boolean @default(false)

  sources     ProductSource[]
  orderSources OrderSource[]
  menuItems   Product[] @relation("FoodShopMenu")
  foodOrders  Order[]   @relation("FoodShopOrders")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([listedInFood])
}


// ============================================================
// PRODUCT â†” VENDOR
// ============================================================

/// A narrower group inside one category (e.g. Belts inside Fashion & Accessories).
model Subcategory {
  id          String   @id @default(cuid())
  categoryId  String
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([categoryId, slug])
  @@index([categoryId, isActive])
}

/// A discovery badge such as Popular or New Arrival. Separate from categories and variants.
model ProductLabel {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)

  products  ProductLabelOnProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductLabelOnProduct {
  productId String
  labelId   String

  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     ProductLabel @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([productId, labelId])
  @@index([labelId])
}

/// An option group a product varies by (e.g. Colour, Size). Defined per product by an admin.
model ProductOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  position  Int      @default(0)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductOptionValue[]

  @@unique([productId, name])
  @@index([productId, position])
}

model ProductOptionValue {
  id       String  @id @default(cuid())
  optionId String
  value    String
  position Int     @default(0)

  option   ProductOption         @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variants ProductVariantValue[]

  @@unique([optionId, value])
  @@index([optionId, position])
}

/// One purchasable combination of a product's option values, with its own price and optional stock.
model ProductVariant {
  id            String        @id @default(cuid())
  productId     String
  /// Sorted option-value ids joined with "|": one variant per combination (unique per product).
  optionKey     String
  sku           String?       @unique
  /// Whole naira, at least 1 (database CHECK).
  price         Int
  /// Null = stock not tracked. Never negative (database CHECK).
  stockQuantity Int?
  status        ProductStatus @default(ACTIVE)
  imageUrl      String?

  product       Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  values        ProductVariantValue[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([productId, optionKey])
  @@index([productId, status])
}

model ProductVariantValue {
  variantId     String
  optionValueId String

  variant       ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue   ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: NoAction)

  @@id([variantId, optionValueId])
  @@index([optionValueId])
}

model ProductSource {
  id          String   @id @default(cuid())

  productId   String
  vendorId    String

  currentPrice Int?
  availability ProductAvailability @default(UNKNOWN)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  priceRecords       PriceRecord[]
  availabilityRecords AvailabilityRecord[]
  itemSourcing OrderItemSourcing[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, vendorId])
  @@index([productId])
  @@index([vendorId])
}

model PriceRecord {
  id              String   @id @default(cuid())

  productSourceId String
  price           Int

  recordedAt      DateTime @default(now())

  productSource   ProductSource @relation(fields: [productSourceId], references: [id], onDelete: Cascade)

  @@index([productSourceId])
  @@index([recordedAt])
}

model AvailabilityRecord {
  id              String              @id @default(cuid())

  productSourceId String
  availability    ProductAvailability

  recordedAt      DateTime @default(now())

  productSource   ProductSource @relation(fields: [productSourceId], references: [id], onDelete: Cascade)

  @@index([productSourceId])
  @@index([recordedAt])
}


// ============================================================
// SAVED LOCATIONS
// ============================================================

model SavedLocation {
  id          String   @id @default(cuid())
  userId      String

  label       String
  address     String
  instructions String?

  latitude    Float?
  longitude   Float?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}


// ============================================================
// CART
// ============================================================

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())

  cartId    String
  productId String

  quantity  Int

  /// "" for a product as it is. For a built plate (productId = its base), the chosen soup and extras,
  /// so different plates on the same base stay separate lines and identical plates merge.
  configKey String   @default("")
  /// The chosen variant of a product with options (configKey is then "variant:<id>").
  variantId String?

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  extras    CartItemExtra[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, configKey])
}


// ============================================================
// ORDERS
// ============================================================

/// A soup or extra chosen for a built plate in the cart. Prices are never stored here: they are read
/// from the product when the cart is priced, and frozen only into the payment snapshot and the order.
model CartItemExtra {
  id         String   @id @default(cuid())
  cartItemId String
  productId  String
  quantity   Int

  cartItem   CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@unique([cartItemId, productId])
  @@index([productId])
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  kind        OrderKind   @default(MARKETPLACE)

  status      OrderStatus

  subtotal    Int
  deliveryFee Int
  total       Int

  // Snapshot of what the customer was charged.
  // This protects historical order records from future price changes.
  currency    String      @default("NGN")

  deliveryLocationId String?
  deliveryAddress    String
  deliveryInstructions String?
  assignedRunnerId String?
  findingRunnerAt DateTime?
  /// Food orders only: the shop the student ordered from. The runner must buy from this shop.
  shopId           String?

  user          User            @relation(fields: [userId], references: [id])
  deliveryLocation SavedLocation? @relation(fields: [deliveryLocationId], references: [id])

  items         OrderItem[]
  printJob      PrintJob?
  payment       Payment?
  assignments   RunnerAssignment[]
  assignedRunner RunnerProfile? @relation("AssignedRunner", fields: [assignedRunnerId], references: [id])
  shop          Vendor?         @relation("FoodShopOrders", fields: [shopId], references: [id], onDelete: Restrict)
  sources       OrderSource[]
  refunds       Refund[]
  statusHistory OrderStatusHistory[]
  incidents     Incident[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deliveredAt   DateTime?

  @@index([userId])
  @@index([kind, status])
  @@index([status])
  @@index([createdAt])
  @@index([shopId])
}

model OrderItem {
  id          String   @id @default(cuid())

  orderId     String
  productId   String

  // Historical snapshots.
  productName String
  unitPrice   Int
  quantity    Int
  totalPrice  Int
  /// Food: the frozen plate (base, soup, extras with names, prices and quantities) or meal at purchase.
  /// Written once when the order is created; menu edits never change it. Null for marketplace items.
  details     Json?
  /// The variant bought, if any. Its options are also frozen in details, so editing or removing the
  /// variant later never changes what the order shows.
  variantId   String?

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourcing    OrderItemSourcing[]
  product     Product  @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}


// ============================================================
// ORDER SOURCES
// ============================================================

model OrderSource {
  id        String @id @default(cuid())

  orderId   String
  vendorId  String

  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vendor    Vendor @relation(fields: [vendorId], references: [id])
  itemSourcing OrderItemSourcing[]

  createdAt DateTime @default(now())

  @@unique([orderId, vendorId])
}

model OrderItemSourcing {
  id                 String                 @id @default(cuid())
  orderItemId        String
  orderSourceId      String
  productSourceId    String
  reportedByRunnerId String
  status             OrderItemSourcingStatus
  quantity           Int                    @default(0)
  catalogueUnitPrice Int
  actualUnitPrice    Int?
  autoApproved       Boolean                @default(false)
  priceDecisionAt    DateTime?
  priceDecisionBy    String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  orderSource   OrderSource   @relation(fields: [orderSourceId], references: [id], onDelete: Cascade)
  productSource ProductSource @relation(fields: [productSourceId], references: [id])
  reportedBy    RunnerProfile @relation(fields: [reportedByRunnerId], references: [id])

  @@index([orderItemId, status])
  @@index([orderSourceId])
  @@index([reportedByRunnerId])
}


// ============================================================
// RUNNER ASSIGNMENTS
// ============================================================

model RunnerAssignment {
  id        String   @id @default(cuid())

  orderId    String?
  printJobId String?
  runnerId   String

  status    RunnerAssignmentStatus @default(OFFERED)

  offeredAt DateTime @default(now())
  acceptedAt DateTime?
  completedAt DateTime?

  order     Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printJob  PrintJob?     @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  runner    RunnerProfile @relation(fields: [runnerId], references: [id])

  @@index([orderId])
  @@index([printJobId])
  @@index([runnerId])
  @@index([status])
  @@unique([orderId, runnerId])
  @@unique([printJobId, runnerId])
}


// ============================================================
// PAYMENTS
// ============================================================

model Payment {
  id                  String          @id @default(cuid())
  userId              String
  orderId             String?         @unique
  printJobId          String?

  provider            PaymentProvider
  status              PaymentStatus   @default(PENDING)
  amount              Int
  currency            String          @default("NGN")

  // PackAM's unique attempt reference and the provider's unique transaction reference.
  transactionReference String?        @unique
  idempotencyKey       String?
  providerReference    String?         @unique
  providerCheckoutReference String?    @unique
  cashierUrl           String?

  // Immutable item/address/price snapshot captured when the attempt is created.
  // Nullable to retain compatibility with payments created before this lifecycle.
  checkoutSnapshot     Json?

  paidAt               DateTime?
  failedAt             DateTime?

  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  order                Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printJob             PrintJob?       @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  // Operations review of this payment. Separate from `status`: closing a case never changes the money state.
  reviewCase           PaymentReviewCase?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([status])
  @@index([status, paidAt])
  @@index([printJobId, status])
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  // A print job can have many attempts (retries after failures) but only one successful payment.
  @@unique([printJobId], map: "Payment_one_success_per_print_job", where: raw("status = 'SUCCESS'"))
  // Database CHECK constraints (not expressible in Prisma), see migration 20261014120000:
  //   Payment_success_requires_fulfilment_root_check: SUCCESS needs an orderId or a printJobId.
  //   Payment_single_fulfilment_root_check: never both an orderId and a printJobId.
}

model PrintJob {
  id                 String         @id @default(cuid())
  userId             String
  orderId            String?        @unique
  status             PrintJobStatus @default(DRAFT)
  findingRunnerAt    DateTime?
  assignedRunnerId   String?

  paperSize          PrintPaperSize @default(A4)
  colorMode          PrintColorMode?
  sides              PrintSides?
  copies             Int            @default(1)
  pageSelection      String         @default("ALL")
  selectedPageCount  Int?
  instructions       String?

  pricePerPage       Int?
  printSubtotal      Int?
  deliveryFee        Int?
  total              Int?
  pricingVersion     String?
  checkoutSnapshot   Json?
  replacesPrintJobId String?

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order              Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedRunner     RunnerProfile? @relation("AssignedPrintRunner", fields: [assignedRunnerId], references: [id], onDelete: SetNull)
  document           PrintDocument?
  payments           Payment[]
  assignments        RunnerAssignment[]
  statusHistory      PrintJobStatusHistory[]

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, findingRunnerAt])
  @@index([assignedRunnerId])
}

model PrintDocument {
  id               String    @id @default(cuid())
  printJobId       String    @unique
  uploadedById     String
  publicId         String    @unique
  originalFileName String
  mimeType         String
  fileSize         Int
  pageCount        Int
  storageProvider  String    @default("CLOUDINARY")
  uploadedAt       DateTime  @default(now())
  expiresAt        DateTime?
  deletedAt        DateTime?

  printJob         PrintJob  @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  uploadedBy       User      @relation("UploadedPrintDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([uploadedById, uploadedAt])
  @@index([expiresAt, deletedAt])
}

model PrintJobStatusHistory {
  id          String         @id @default(cuid())
  printJobId  String
  status      PrintJobStatus
  note        String?
  actorId     String?
  createdAt   DateTime       @default(now())

  printJob    PrintJob       @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  actor       User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([printJobId, createdAt])
  @@index([actorId, createdAt])
}


// ============================================================
// REFUNDS
// ============================================================

model Refund {
  id          String       @id @default(cuid())

  orderId     String

  amount      Int
  reason      String

  status      RefundStatus @default(PENDING)

  transactionReference String?
  requestKey  String? @unique

  processedAt DateTime?

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}


// ============================================================
// ORDER STATUS HISTORY
// ============================================================

model OrderStatusHistory {
  id        String      @id @default(cuid())

  orderId   String
  status    OrderStatus

  note      String?
  createdBy String?

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime    @default(now())

  @@index([orderId])
  @@index([createdAt])
}


// ============================================================
// PRODUCT REQUESTS
// ============================================================

model ProductRequest {
  id          String              @id @default(cuid())

  userId      String
  productId   String?

  requestedName String
  quantity      Int               @default(1)
  variant       String?
  description   String?

  status      ProductRequestStatus @default(PENDING)

  user        User                @relation(fields: [userId], references: [id])
  product     Product?            @relation(fields: [productId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}


// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(cuid())

  userId    String

  type      NotificationType
  title     String
  message   String

  isRead    Boolean          @default(false)

  orderId   String?
  idempotencyKey String?
  relatedType String?
  relatedId   String?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@unique([userId, idempotencyKey])
}


// ============================================================
// SUPPORT
// ============================================================

model SupportCase {
  id          String            @id @default(cuid())

  userId      String

  subject     String
  description String

  status      SupportCaseStatus @default(OPEN)

  orderId     String?
  resolution  String?
  handledById String?

  user        User              @relation(fields: [userId], references: [id])
  handledBy   User?             @relation("HandledSupportCases", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([orderId])
  @@index([handledById])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String
  action       String
  resource     String
  resourceId   String
  previousState Json?
  newState      Json?
  details      String?
  createdAt    DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId, createdAt])
  @@index([resource, resourceId, createdAt])
  @@index([action, createdAt])
}

/// One anonymous page view for admin analytics. No account, IP address, user agent or query string is stored:
/// visitorId and sessionId are random ids made by the visitor's browser. viewId makes a retried send a no-op.
model PageView {
  id        String   @id @default(cuid())
  viewId    String   @unique
  visitorId String
  sessionId String
  path      String
  /// The referring site's host only (e.g. "instagram.com"), when it isn't PackAM itself.
  referrerHost String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([sessionId, createdAt])
}

model RateLimitBucket {
  id         String   @id @default(cuid())
  key        String
  windowStart DateTime
  count      Int      @default(0)
  expiresAt  DateTime

  @@unique([key, windowStart])
  @@index([expiresAt])
}


// ============================================================
// INCIDENTS
// ============================================================

model Incident {
  id          String         @id @default(cuid())

  orderId     String
  reportedById String

  type        IncidentType
  status      IncidentStatus @default(OPEN)

  description String?
  resolution  String?

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reportedBy  User           @relation("ReportedIncidents", fields: [reportedById], references: [id])

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([orderId])
  @@index([reportedById])
  @@index([status])
}


// ============================================================
// RUNNER PAYOUTS
// ============================================================

model RunnerPayout {
  id          String       @id @default(cuid())

  runnerId    String

  amount      Int
  status      PayoutStatus @default(PENDING)

  periodStart DateTime?
  periodEnd   DateTime?

  reference   String?

  runner      RunnerProfile @relation(fields: [runnerId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([runnerId])
  @@index([status])
}

/// Admin review of a payment that is unresolved (needs reconciliation, stuck pending, or similar).
/// The payment's own status stays the single source of truth for money; this row only tracks the
/// operational case, the last admin-triggered OPay check, and a short lock against overlapping checks.
/// Every change is also written to AuditLog with the admin's identity and reason.
model PaymentReviewCase {
  id                   String              @id @default(cuid())
  paymentId            String              @unique
  status               PaymentReviewStatus @default(OPEN)

  lastCheckAt          DateTime?
  /// CONFIRMED_SUCCESS | CONFIRMED_FAILED | PROVIDER_PENDING | PROVIDER_UNAVAILABLE | MISMATCH | UNDER_REVIEW
  lastCheckOutcome     String?
  /// Secret-free detail: provider status, error class, provider response code.
  lastCheckDetail      String?
  checkCount           Int                 @default(0)
  /// While set in the future, another verification for this payment is already running.
  checkLockedUntil     DateTime?

  closedAt             DateTime?
  closedById           String?
  closeNote            String?
  escalatedAt          DateTime?

  payment              Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([status, updatedAt])
}
